<Window x:Class="WpfAspireApp.WpfApp.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aspire Weather" Height="360" Width="560" MinHeight="300" MinWidth="460"
        Loaded="RefreshForecast">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Weather forecast" FontSize="24" Margin="0,0,0,16" />

        <DataGrid x:Name="Forecasts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="*" />
                <DataGridTextColumn Header="Temperature (°C)" Binding="{Binding TemperatureC}" Width="*" />
                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshForecast" DockPanel.Dock="Right"
                    Padding="16,6" Margin="16,0,0,0" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
