<idea-plugin>
    <dependencies>
        <module name="intellij.aspire.shared"/>
        <module name="intellij.aspire.core"/>
        <plugin id="com.jetbrains.opentelemetry"/>
        <module name="intellij.opentelemetry.core"/>
    </dependencies>

    <applicationListeners>
        <listener class="com.jetbrains.aspire.opentelemetry.AspireOpenTelemetryServerListener"
                  topic="com.jetbrains.opentelemetry.core.service.OpenTelemetryServerListener"/>
    </applicationListeners>
</idea-plugin>