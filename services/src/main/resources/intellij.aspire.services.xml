<idea-plugin>
    <dependencies>
        <module name="intellij.aspire.shared"/>
        <module name="intellij.aspire.core"/>
        <plugin id="intellij.execution.serviceView.plugin"/>
    </dependencies>

    <resource-bundle>messages.AspireServicesBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <serviceViewContributor implementation="com.jetbrains.aspire.services.AspireMainServiceViewContributor"/>
        <iconMapper mappingFile="AspireServicesIconMappings.json"/>
    </extensions>

    <actions>
        <action id="Aspire.AddCliRunConfiguration"
                class="com.jetbrains.aspire.services.actions.AspireAddCliRunConfigurationAction"
                icon="com.jetbrains.aspire.AspireIcons.RunConfig">
            <add-to-group group-id="ServiceView.AddService"/>
            <add-to-group group-id="ToolsMenu.Services"/>
        </action>
    </actions>
</idea-plugin>
